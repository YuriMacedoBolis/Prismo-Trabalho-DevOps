# =============================================================================
#  Prismo — modelo de configuracao
#
#  Copie para .env e preencha:   cp .env.example .env
#  O arquivo .env esta no .gitignore e NUNCA deve ser commitado.
#  Em producao estes valores viram um Secret do Kubernetes.
# =============================================================================

# --- Geral -------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Supabase ----------------------------------------------------------------
# No painel do Supabase: Project Settings > Database > Connection string > URI.
# Troque o prefixo "postgresql://" por "postgresql+asyncpg://" (driver async).
# Use a porta 6543 (pooler) e nao a 5432: o pooler aguenta muito mais conexoes,
# o que importa porque teremos varias replicas de varios servicos.
DATABASE_URL=postgresql+asyncpg://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Project Settings > API
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_ANON_KEY=
# Service key ignora Row Level Security. So em servico de backend, jamais no
# navegador.
SUPABASE_SERVICE_KEY=

# Para usar o Postgres em container em vez do Supabase, suba com
# `--profile local-db` e troque a linha acima por:
# DATABASE_URL=postgresql+asyncpg://prismo:prismo@postgres:5432/prismo

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- Autenticacao ------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isto-antes-de-qualquer-coisa
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Conector GitHub ---------------------------------------------------------
# github.com/settings/developers > New OAuth App
# Callback: http://localhost:8001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Storage: Google Drive ---------------------------------------------------
# 1. console.cloud.google.com > projeto novo > ative a Google Drive API
# 2. Crie uma Service Account e baixe a chave JSON
# 3. Crie uma pasta no Drive e compartilhe com o e-mail da service account
# 4. O ID da pasta esta na URL: drive.google.com/drive/folders/<ID>
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
GOOGLE_DRIVE_FOLDER_ID=

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
