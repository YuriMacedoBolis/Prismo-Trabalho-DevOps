# =============================================================================
#  Prismo — modelo de configuracao
#
#  Copie para .env e preencha:   cp .env.example .env
#  O arquivo .env esta no .gitignore e NUNCA deve ser commitado.
#  Em producao estes valores viram um Secret do Kubernetes.
# =============================================================================

# --- Geral -------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Banco de dados ----------------------------------------------------------
# Postgres roda como container da propria stack (servico `postgres`).
# O host e o NOME DO SERVICO, resolvido pelo DNS interno do Docker.
DATABASE_URL=postgresql+asyncpg://prismo:prismo@postgres:5432/prismo

# De FORA dos containers (DBeaver, pgAdmin, script no Windows) o mesmo banco
# responde em localhost, e sem o sufixo +asyncpg:
#   postgresql://prismo:prismo@localhost:5432/prismo

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- Autenticacao ------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isto-antes-de-qualquer-coisa
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Conector GitHub ---------------------------------------------------------
# MODO SIMULADO (padrao): o conector gera repositorios deterministicos, sem
# chamar a API do GitHub. Permite desenvolver e apresentar sem credencial e
# sem depender de rede.
GITHUB_MODO_SIMULADO=true
GITHUB_ITENS_SIMULADOS=12

# Para usar a API real, preencha as duas linhas abaixo e troque o modo para
# false. Credenciais em github.com/settings/developers > New OAuth App,
# com callback http://localhost:8001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Sincronizacao -----------------------------------------------------------
SYNC_INTERVALO_MINUTOS=30

# --- Storage: Google Drive ---------------------------------------------------
# 1. console.cloud.google.com > projeto novo > ative a Google Drive API
# 2. Crie uma Service Account e baixe a chave JSON
# 3. Crie uma pasta no Drive e compartilhe com o e-mail da service account
# 4. O ID da pasta esta na URL: drive.google.com/drive/folders/<ID>
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
GOOGLE_DRIVE_FOLDER_ID=

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
