# =============================================================================
#  Arquivos que NAO devem entrar no contexto de build.
#
#  Serve a dois propositos. Seguranca: sem esta lista, o `.env` com as
#  credenciais do banco seria copiado para dentro da imagem e qualquer
#  pessoa com acesso a ela leria os segredos com `docker history`. Velocidade:
#  o contexto e enviado inteiro ao daemon do Docker a cada build, e mandar
#  .venv/ e node_modules/ torna isso lento sem necessidade.
# =============================================================================

# Segredos — o motivo principal deste arquivo
.env
.env.*
!.env.example
*.pem
*.key
secrets/
google-sa.json
*-service-account*.json

# Ambientes virtuais e dependencias
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/

# Caches de ferramenta
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Git e CI
.git/
.github/
.gitignore

# Nada disto e usado em tempo de execucao
docs/
k8s/
observability/
scripts/
*.md
Makefile
dev.ps1
docker-compose*.yml

# Sistema operacional e editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log
